# ---------------------------------------------------------------------------
# Sporty OTP Lab - API configuration
# Copy to `.env` and adjust. All values are optional.
# ---------------------------------------------------------------------------

# Name shown in the API docs
APP_NAME=Sporty OTP Lab

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273,http://localhost:5173,http://127.0.0.1:5173

# SQLAlchemy database URL (SQLite by default; swap for Postgres in production)
DATABASE_URL=sqlite:///./sporty.db

# ---------------------------------------------------------------------------
# OTP/signup provider
#   sportybet  - REAL SportyBet registration; real OTPs are texted by
#                SportyBet to the client's phone (default, and the ONLY
#                provider; requires playwright + chromium, see README).
# ---------------------------------------------------------------------------
PROVIDER=sportybet

# ---- SportyBet (Kenya + Nigeria only) --------------------------------------
# Keep false during development to see the browser; true for server runs.
SPORTYBET_HEADLESS=false
# Default signup URL (Nigeria). Opening the right country URL also sets the
# phone's dial-code prepend on the register form (+234 on /ng/, +254 on /ke/).
SPORTYBET_ONBOARDING_URL=https://www.sportybet.com/ng/
# Optional per-country overrides.
SPORTYBET_ONBOARDING_URL_NG=
SPORTYBET_ONBOARDING_URL_KE=https://www.sportybet.com/ke/
# Human-likeness (ms). sporty: no robotic bursts.
SPORTYBET_KEYSTROKE_MIN_MS=40
SPORTYBET_KEYSTROKE_MAX_MS=120
SPORTYBET_FORM_DELAY_MS=600
# Random wait after the OTP request before we call it delivered (OTPs are real,
# delivery to the phone can take up to ~60s).
SPORTYBET_AFTER_SEND_MIN_MS=30000
SPORTYBET_AFTER_SEND_MAX_MS=60000
# How long send_otp waits for the browser worker to confirm the OTP request.
SPORTYBET_SEND_TIMEOUT_SECONDS=120
# The live browser stays parked on the OTP screen waiting for the operator to
# type the code they received on the phone — this long before giving up.
SPORTYBET_OTP_WINDOW_SECONDS=600
# CAPTCHA fallback: when a challenge appears the adapter pauses and the operator
# solves it in the headed browser window. Seconds to wait before giving up.
SPORTYBET_CAPTCHA_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Optional API token. If set, every request needs:  Authorization: Bearer <token>
API_TOKEN=

# Optional Fernet key (32-byte urlsafe base64) used to encrypt passwords at
# rest. Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, values are stored in plaintext and a warning is logged on boot.
ENCRYPT_KEY=

# OTP lifetime and generated-password strength
OTP_TTL_SECONDS=300
PASSWORD_LENGTH=16